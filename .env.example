# ─── BASE DE DATOS ─────────────────────────────────────────────────────────────
# Para desarrollo local con SQLite (descomentar si no tienes PostgreSQL local):
# DATABASE_URL="file:./dev.db"

# Para PostgreSQL local o Supabase/Neon en desarrollo:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/invictus?schema=public"

# DIRECT_URL es necesario con Supabase/Neon + connection pooling (PgBouncer)
# Si usas Neon con pooler: usa la URL normal en DATABASE_URL y la directa aquí
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/invictus?schema=public"

# ─── NEXTAUTH ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="invictus-mentoria-super-secret-key-2024-trading"
NEXTAUTH_URL="http://localhost:3001"
